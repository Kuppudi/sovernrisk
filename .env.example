# Development credentials only. Change before exposing any service.
POSTGRES_DB=sovereign_risk
POSTGRES_USER=sovereign
POSTGRES_PASSWORD=local_dev_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://sovereign:local_dev_only@localhost:5432/sovereign_risk
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RAW_DATA_DIR=data/raw
WORLD_BANK_BASE_URL=https://api.worldbank.org/v2
REPORT_DATA_DIR=data/reports
# Optional: private JSON research results uploaded after local training.
# When set, prediction/model/map reads use Blob instead of SQL tables.
PREDICTIONS_BLOB_URL=
# Optional development override. A result bundled by --predictions-file is
# discovered automatically in App Service, without this setting or Blob access.
PREDICTIONS_FILE=
# Azure OpenAI answers use an existing chat model deployment. Keep the key server-side.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
# Vite proxies /api and /health to this address in development.
API_PROXY_TARGET=http://127.0.0.1:8000
# Frontend requests use the page's own URL, including in Azure App Service.
# Optional override; the frontend build is normally found automatically.
# FRONTEND_DIR=/absolute/path/to/frontend/dist
